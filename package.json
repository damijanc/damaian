{
  "name": "damaian-client",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI coding assistant client workspace engine",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint:web": "biome check",
    "lint:web:fix": "biome check --write",
    "updater:enable-artifacts": "node scripts/enable-updater-artifacts.mjs",
    "updater:manifest": "node scripts/create-updater-manifest.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "desktop:dev": "cd crates/desktop-app && cargo tauri dev",
    "desktop:build": "cd crates/desktop-app && APPLE_SIGNING_IDENTITY=\"${APPLE_SIGNING_IDENTITY:--}\" cargo tauri build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7"
  }
}
